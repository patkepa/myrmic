# Linux device manifest: the devices the pipeline reads.
id: {{name}}
chip: linux

# I2C buses by their Linux character device.
buses:
  i2c0:
    transport: i2c
    pins: {}
    freq_khz: 400
    dev_path: /dev/i2c-1

gpios:
  general_purpose: []

# sim-source is synthetic and ignores the bus, so this builds and runs
# with no hardware. Swap it for a real sensor and set the bus dev_path.
devices:
  - id: sim
    driver: sim-source
    bus: i2c0
